{
    "framework": "vite",
    "outputDirectory": "dist",
    "installCommand": "npm install && cd api && npm install",
    "buildCommand": "npm run build",
    "functions": {
        "api/index.js": {
            "maxDuration": 25,
            "includeFiles": "server/**"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}