{
    "installCommand": "npm install && cd api && npm install",
    "buildCommand": "npm run build",
    "functions": {
        "api/index.js": {
            "maxDuration": 25
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ]
}