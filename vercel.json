{
    "version": 2,
    "functions": {
        "api/proxy.js":     { "maxDuration": 60 },
        "api/chat.js":      { "maxDuration": 60 },
        "api/translate.js": { "maxDuration": 60 }
    },
    "rewrites": [
        {
            "source": "/api/chat",
            "destination": "/api/chat"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/proxy?path=:path*"
        },
        {
            "source": "/:path*",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*\\.html)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate, max-age=0"
                }
            ]
        }
    ]
}